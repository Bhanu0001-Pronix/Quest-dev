TOOLS:
  qd_lookup_patient_records(patientDateOfBirth: string) -> object
    description: "Looks up patient records by date of birth. Returns every patient whose date of birth matches, with their accessions; the flow keeps only the patient whose normalized name matches exactly."
    type: http
    params:
      patientDateOfBirth:
        description: "The patient's date of birth as YYYY-MM-DD."
    endpoint: "{{env.QD_API_BASE_URL}}/Patients?patientDateOfBirth={{patientDateOfBirth}}"
    method: GET
    timeout: 2500
    retry: 1
    retry_delay: 300
    circuit_breaker:
      threshold: 5
      reset_ms: 30000